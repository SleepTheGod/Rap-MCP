# Environment Configuration
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://rapbattle_user:rapbattle_secret_pwd@postgres:5432/rapbattle_db

# Redis
REDIS_URL=redis://redis:6379

# Authentication & JWT Secrets
JWT_SECRET=super_secret_jwt_signing_key_production_32char_min
SESSION_SECRET=super_secret_session_key_production_32char_min
MCP_TOKEN_SECRET=mcp_oauth_secret_key_production_32chars

# AI Provider (Gemini / Anthropic / Local fallback)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
JUDGE_MODEL=gemini-3.1-pro-preview

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
